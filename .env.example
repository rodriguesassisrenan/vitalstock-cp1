# Copie para .env e preencha. O .env não vai para o Git.
APP_ENV=development
DATABASE_URL=sqlite:///./estoque.db
AUTO_SEED=true

# Origens extras liberadas no CORS, separadas por vírgula.
# Vazio = só a própria aplicação (o frontend é servido pela API).
CORS_ORIGINS=

# Sem chave, a leitura de relatos usa o extrator por regras.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
