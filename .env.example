# ==========================================================
# VITALSTOCK - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (CP2/CP3)
# Copie este arquivo para .env e preencha caso deseje usar chave própria.
# NUNCA versione chaves reais no GitHub!
# ==========================================================

PROJECT_NAME="VitalStock API - Gestão Hospitalar & IA"
APP_VERSION="3.0.0"
APP_ENV="production"

# URL do Banco de Dados (SQLite local/container ou PostgreSQL em nuvem)
DATABASE_URL="sqlite:///./estoque.db"

# Seed automático de medicamentos e categorias hospitalares ao iniciar banco vazio
AUTO_SEED="true"

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS="*"

# Chave da API do Google Gemini (Opcional: se vazio, utiliza o Motor NLP Clínico Local Determinístico)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
